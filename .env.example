# Lead delivery
# The browser form sends to Web3Forms using the public access key in
# src/lib/leads.ts (primary), with FormSubmit.co as a fallback. If you want
# the optional /api/leads Vercel route to deliver too, set one of the
# server-side options below; otherwise the browser path is sufficient.

# Server-side email for /api/leads — set GMAIL_APP_PASSWORD OR WEB3FORMS_ACCESS_KEY
GMAIL_APP_PASSWORD=
WEB3FORMS_ACCESS_KEY=
# Optional Google Sheets/Apps Script webhook for the /api/leads fallback
GOOGLE_SHEETS_WEBHOOK=

# WhatsApp delivery — pick ONE (recommended: CallMeBot, 2 minutes, free)
# 1. Add +34 644 64 24 24 in WhatsApp
# 2. Send: I allow callmebot to send me messages
# 3. Paste the apikey you receive
CALLMEBOT_APIKEY=

# Or Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Or a Make.com / n8n / Interakt webhook that posts to WhatsApp
LEAD_WEBHOOK_URL=

LEAD_EMAIL=zenwebstudio.in@gmail.com
WHATSAPP_PHONE=919584559972

# Optional lead store
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics 4 — leave blank until you have a real ID
VITE_GA_MEASUREMENT_ID=
